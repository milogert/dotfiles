@define-color black #1C1B19;
@define-color blue #2C78BF;
@define-color bright_black #918175;
@define-color bright_blue #68A8E4;
@define-color bright_cyan #53FDE9;
@define-color bright_green #98BC37;
@define-color bright_magenta #FF5C8F;
@define-color bright_orange #FF8700;
@define-color bright_red #F75341;
@define-color bright_white #FCE8C3;
@define-color bright_yellow #FED06E;
@define-color cyan #0AAEB3;
@define-color green #519F50;
@define-color hard_black #121212;
@define-color magenta #E02C6D;
@define-color orange #D75F00;
@define-color red #EF2F27;
@define-color white #D0BFA1;
@define-color xgray1 #262626;
@define-color xgray2 #303030;
@define-color xgray3 #3A3A3A;
@define-color xgray4 #444444;
@define-color xgray5 #4E4E4E;
@define-color yellow #FBB829;

/*
 * vim: ft=less
 */

/* @define-color bg rgba(42, 42, 42, 0.7); */
/* @define-color bg-hover rgba(65, 65, 65, 0.7); */
/* @define-color text-color white; */
/* @define-color text-color-disabled rgba(255, 255, 255, 0.4); */
/* @define-color accent-color rgb(0, 128, 255); */
@define-color bg rgba(42, 42, 42, 0.7);
@define-color bg-hover rgba(65, 65, 65, 0.7);
@define-color text-color #FCE8C3;
@define-color text-color-disabled rgba(255, 255, 255, 0.4);
@define-color accent-color #68A8E4;

* {
  border: none;
  border-radius: 0;
  /* font-family: FontAwesome, "Clear Sans"; */
  font-family: FontAwesome, "Hack";
  font-size: 17px;
  font-weight: bold;
  min-height: 0;
}

window#waybar {
  color: @text-color;
  transition-property: background-color;
  transition-property: color;
  transition-duration: 0.25s;
}

window#waybar.hidden {
  opacity: 0.2;
}

window {
  background: transparent;
  border-radius: 0;
}

window > box {
  margin: 10px;
  margin-bottom: 0;
  border-radius: 12px;
  background: @bg;
  background-clip: border-box;
}

/* All module containers */
window box > box {
  padding: 0 8px;
  border-radius: 12px;
}

/* All modules */
window > box > box > widget > * {
  padding: 0 8px;
}

window > box > box > widget > button:hover {
  background: @bg-hover;
}

.modules-left {
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
}

.modules-right {
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
}

window > box > box > widget button:insensitive {
  color: @text-color;
  font-weight: bold;
}

#workspaces button {
  /* padding: 0 10px; */
  background-color: transparent;
  /* Use box-shadow instead of border so the text isn't offset */
  box-shadow: inset 0 -3px transparent;
  color: @text-color;
}

/* https://github.com/Alexays/Waybar/wiki/FAQ#the-workspace-buttons-have-a-strange-hover-effect */
#workspaces button.visible,
#workspaces button:hover {
  box-shadow: inset 0 -2px #555555;
}

#workspaces button:hover {
  background: @bg-hover;
}

#workspaces button.focused {
  box-shadow: inset 0 -2px @accent-color;
}

#workspaces button.urgent {
  color: #bd2c40;
  box-shadow: inset 0 -2px #bd2c40;
}

#gamemode {
  color: @text-color-disabled;
}
#gamemode.running {
  color: @text-color;
}

#backlight {
  background-color: #90b1b1;
}

#custom-airplane {
  font-size: 24px;
}

#bluetooth {
  font-size: 22px;
}

#bluetooth.disabled,
#bluetooth.off {
  color: @text-color-disabled;
}

#network {
  font-family: "Material Icons Round", "Font Awesome 6 Free";
  font-size: 22px;
}

#network.disconnected,
#network.linked {
  color: @text-color-disabled;
}

#pulseaudio.muted {
  color: @text-color-disabled;
}

#privacy {
    padding: 0;
    border-radius: 50px;
}

#privacy > box {
    padding: 0;
}

#privacy-item {
    padding: 0 6px;
    color: @text-color;
}
